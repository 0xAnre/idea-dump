# Copy to .env and fill in. Do not commit .env.
# Telegram bot token from @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Primary provider: OpenCode Go (https://opencode.ai/)
OPENCODE_API_KEY=
# Text: rewrite + wiki maintainer
OPENCODE_CHAT_MODEL=deepseek-v4.1-flash
# Images sent without a caption
OPENCODE_VISION_MODEL=glm-5.3-flash

# Silent fallback: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Must accept images, otherwise image-only messages cannot be retried here
OPENROUTER_VISION_MODEL=
