<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.idea-dump.sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/ABS/PATH/TO/idea-dump/scripts/sync-wiki-from-vps.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>IDEA_DUMP_SYNC_ENV</key>
		<string>/ABS/PATH/TO/idea-dump/scripts/obsidian-sync.env</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>StandardOutPath</key>
	<string>/tmp/idea-dump-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/idea-dump-sync.err</string>
</dict>
</plist>
