# Copy to scripts/obsidian-sync.env and fill in your values.
# Do not commit the filled file.

IDEA_DUMP_SSH_HOST=user@your-vps
IDEA_DUMP_SSH_KEY=~/.ssh/your_key
IDEA_DUMP_REMOTE_KB=/opt/idea-dump/knowledge-base
IDEA_DUMP_LOCAL_KB="$HOME/Documents/Idea Dump Wiki"

# Optional. 1 = also delete local files that are gone on the VPS
# (except .obsidian/ and .trash/). VPS remains source of truth.
# IDEA_DUMP_RSYNC_DELETE=1
# IDEA_DUMP_RSYNC_MAX_DELETE=50
